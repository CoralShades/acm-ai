# ═══════════════════════════════════════════════════════════════════════════════
# ACM-AI Project Environment — Asbestos Compliance Management
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your keys.
# This is a project-specific subset — see .env.example for the full reference.

# ─── API ─────────────────────────────────────────────────────────────────────
API_URL=http://localhost:5055

# ─── SurrealDB ───────────────────────────────────────────────────────────────
SURREAL_URL=ws://127.0.0.1:8000/rpc
SURREAL_USER=root
SURREAL_PASSWORD=root
SURREAL_NAMESPACE=open_notebook
SURREAL_DATABASE=development

# ─── Worker ──────────────────────────────────────────────────────────────────
SURREAL_COMMANDS_RETRY_ENABLED=true
SURREAL_COMMANDS_RETRY_MAX_ATTEMPTS=3
SURREAL_COMMANDS_RETRY_WAIT_STRATEGY=exponential_jitter
SURREAL_COMMANDS_RETRY_WAIT_MIN=1
SURREAL_COMMANDS_RETRY_WAIT_MAX=30
SURREAL_COMMANDS_MAX_TASKS=5

# ─── AI Providers ────────────────────────────────────────────────────────────
# At least one provider is required. Ollama recommended for local-first.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...
OLLAMA_API_BASE=http://localhost:11434

# ACM pipeline keys — separate from personal/Claude Code keys (E30-S8)
# These are used ONLY by the extraction pipeline, never by Claude Code tooling.
# ACM_ANTHROPIC_API_KEY=sk-ant-...
# ACM_OPENROUTER_API_KEY=sk-or-...

# ─── Default Models ──────────────────────────────────────────────────────────
# Format: provider/model_name — auto-provisioned on API startup.
# Recommended: Ollama local models for RTX 4090 24GB.
DEFAULT_CHAT_MODEL=ollama/qwen3:latest
DEFAULT_TRANSFORMATION_MODEL=ollama/qwen3:32b
DEFAULT_TOOLS_MODEL=ollama/qwen3:32b
DEFAULT_LARGE_CONTEXT_MODEL=ollama/qwen2.5:32b
DEFAULT_EXTRACTION_MODEL=ollama/qwen2.5:7b
DEFAULT_EMBEDDING_MODEL=ollama/mxbai-embed-large
MODEL_FALLBACK_PROVIDERS=ollama,anthropic,openrouter,openai

# ─── Docling Table Extraction ────────────────────────────────────────────────
DOCLING_DIRECT_TABLE_EXTRACTION=true
DOCLING_TABLE_STRUCTURE=false
DOCLING_TABLE_MODE=accurate

# ─── MinerU (optional — deprecated in favor of MinerU 2.x in main venv) ─────
MINERU_ENABLED=false
MINERU_VENV_PATH=.venv-mineru

# ═══════════════════════════════════════════════════════════════════════════════
# OBSERVABILITY STACK
# ═══════════════════════════════════════════════════════════════════════════════
# All three are opt-in and non-fatal. Disable by setting =false / removing keys.

# --- LangSmith (cloud, dev only — free tier: 5k traces/month) ---
# Get key: https://smith.langchain.com → Settings → API Keys
# LANGCHAIN_API_KEY is the primary key. LANGSMITH_API_KEY is an alias.
# Project auto-creates on first trace.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=acm-ai-dev

# --- Langfuse (cloud or self-hosted) ---
# Cloud: https://cloud.langfuse.com → create project → copy keys
# Self-hosted: docker compose -f docker-compose.yml -f docker-compose.observability.yml up -d
#   Then set LANGFUSE_BASE_URL=http://localhost:3000 and create account at that URL.
LANGFUSE_ENABLED=true
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Logfire (Pydantic validation traces -> Langfuse via OTel) ---
# When true, Logfire SDK instruments Pydantic v2 validation and sends spans to Langfuse.
# Requires LANGFUSE_ENABLED=true and Langfuse keys configured.
# No Logfire cloud account needed -- traces go to your self-hosted Langfuse.
LOGFIRE_ENABLED=false

# --- LangGraph Dev Server (local graph debugging) ---
# Install: uv tool install langgraph-cli[inmem]
# Run: uv run langgraph dev  (NOT bare `langgraph dev` — needs project venv)
# API: http://127.0.0.1:2024  |  Swagger UI: http://127.0.0.1:2024/docs
# Registered graphs: acm_extraction, supervisor (see langgraph.json)
# Note: Studio visual UI requires LangSmith cloud. Use local API + Langfuse for fully-local debugging.
