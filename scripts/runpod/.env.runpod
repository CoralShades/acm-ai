# ACM-AI RunPod Environment Variables
# Copy to /workspace/acm-ai/.env on the pod

# API CONFIGURATION
# API_URL: returned by /config route — tells the browser where to make API calls.
# INTERNAL_API_URL: used by Next.js server-side rewrites (stays localhost on pod).
# Update API_URL to match your access method (Cloudflare tunnel or RunPod proxy).
API_URL=https://acmapi.silvatron.au
INTERNAL_API_URL=http://localhost:5055
API_HOST=0.0.0.0
API_PORT=5055
API_RELOAD=false

# CONNECTION DETAILS FOR SURREALDB (native on pod)
SURREAL_URL=ws://localhost:8000/rpc
SURREAL_USER=root
SURREAL_PASSWORD=root
SURREAL_NAMESPACE=open_notebook
SURREAL_DATABASE=development

# WORKER CONFIGURATION
SURREAL_COMMANDS_RETRY_ENABLED=true
SURREAL_COMMANDS_RETRY_MAX_ATTEMPTS=3
SURREAL_COMMANDS_RETRY_WAIT_STRATEGY=exponential_jitter
SURREAL_COMMANDS_RETRY_WAIT_MIN=1
SURREAL_COMMANDS_RETRY_WAIT_MAX=30
SURREAL_COMMANDS_MAX_TASKS=5

# AI PROVIDERS
OLLAMA_API_BASE=http://localhost:11434
OLLAMA_NUM_CTX=32768
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_NUM_PARALLEL=2

# RunPod image sets HF_HUB_ENABLE_HF_TRANSFER=1 which requires the hf_transfer
# package. Disable it to avoid import errors during model downloads.
HF_HUB_ENABLE_HF_TRANSFER=0

# TABLE EXTRACTION
# DOCLING_TABLE_MODE: "accurate" (best quality, slower) or "fast" (quick demos)
DOCLING_TABLE_STRUCTURE=true
DOCLING_TABLE_MODE=accurate
DOCLING_DIRECT_TABLE_EXTRACTION=true

# MINERU (disabled by default on RunPod)
MINERU_ENABLED=false

# PER-ROW EXTRACTION MODE
ACM_ITEM_EXTRACTION_MODE=per_row
ACM_ROW_EXTRACTION_NUM_CTX=2048
ACM_EXTRACTION_MODEL=gemma4:e4b

# DEFAULT MODEL CONFIGURATION (Gemma4 family on RTX 5090 32GB)
DEFAULT_CHAT_MODEL=ollama/gemma4:latest
DEFAULT_TRANSFORMATION_MODEL=ollama/gemma4:26b
DEFAULT_TOOLS_MODEL=ollama/gemma4:26b
DEFAULT_LARGE_CONTEXT_MODEL=ollama/gemma4:31b
DEFAULT_EXTRACTION_MODEL=ollama/gemma4:26b
DEFAULT_EMBEDDING_MODEL=ollama/mxbai-embed-large
MODEL_FALLBACK_PROVIDERS=ollama,anthropic,openrouter,openai

# OBSERVABILITY — Langfuse (Docker stack on pod)
LANGFUSE_ENABLED=true
LANGFUSE_SECRET_KEY="sk-lf-CHANGE-ME"
LANGFUSE_PUBLIC_KEY="pk-lf-CHANGE-ME"
LANGFUSE_BASE_URL="http://localhost:3000"

# LangSmith (optional, cloud)
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=ACM-AI

# Logfire (disabled by default)
LOGFIRE_ENABLED=false

# CORS — allow Cloudflare tunnel + RunPod proxy + Vercel + local dev
CORS_ALLOWED_ORIGINS=https://acm.silvatron.au,https://acmapi.silvatron.au,https://qpzht3hvrbg95w-8502.proxy.runpod.net,https://qpzht3hvrbg95w-5055.proxy.runpod.net,https://acmv3.coralshades.ai,https://demo.vaea.coralshades.ai,http://localhost:8502,http://localhost:8503
