{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run test *)",
      "Bash(npm run build)",
      "Bash(npm test *)",
      "Bash(npx prisma *)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx playwright *)",
      "Bash(npx vitest *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(test -f *)",
      "Bash(rm .claude/ralph-loop.local.md)",
      "Bash(chmod +x *)",
      "Bash(cd frontend *)",
      "Bash(python3 *)",
      "Bash(ruff check *)",
      "Bash(ruff format *)",
      "Bash(pytest *)",
      "Bash(uv run *)",
      "mcp__filesystem__directory_tree"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",

      "Bash(sf project deploy*)",
      "Bash(sf deploy*)",
      "Bash(sf project deploy start*)",
      "Bash(sf project deploy validate*)",
      "Bash(sf project deploy quick*)",
      "Bash(sf project deploy cancel*)",
      "Bash(sf project deploy resume*)",

      "Bash(sf data create*)",
      "Bash(sf data update*)",
      "Bash(sf data delete*)",
      "Bash(sf data upsert*)",
      "Bash(sf data import*)",
      "Bash(sf data import tree*)",
      "Bash(sf data import bulk*)",
      "Bash(sf data delete bulk*)",
      "Bash(sf data delete record*)",
      "Bash(sf data update record*)",
      "Bash(sf data create record*)",
      "Bash(sf data upsert bulk*)",
      "Bash(sf data resume*)",

      "Bash(sf apex run*)",
      "Bash(sf apex execute*)",

      "Bash(sf org delete*)",
      "Bash(sf org create*)",
      "Bash(sf org resume*)",
      "Bash(sf org login*)",
      "Bash(sf org logout*)",
      "Bash(sf config set target-org*)",
      "Bash(sf config set*)",
      "Bash(sf alias set*)",
      "Bash(sf alias unset*)",

      "Bash(sf schema generate*)",
      "Bash(sf project generate*)",

      "Bash(sf package create*)",
      "Bash(sf package delete*)",
      "Bash(sf package install*)",
      "Bash(sf package uninstall*)",
      "Bash(sf package version create*)",
      "Bash(sf package version delete*)",
      "Bash(sf package version promote*)",

      "Bash(sfdx force:source:deploy*)",
      "Bash(sfdx force:source:push*)",
      "Bash(sfdx force:mdapi:deploy*)",
      "Bash(sfdx force:data:record:create*)",
      "Bash(sfdx force:data:record:update*)",
      "Bash(sfdx force:data:record:delete*)",
      "Bash(sfdx force:data:bulk:upsert*)",
      "Bash(sfdx force:data:bulk:delete*)",
      "Bash(sfdx force:apex:execute*)",
      "Bash(sfdx force:org:delete*)",
      "Bash(sfdx force:org:create*)",
      "Bash(sfdx force:auth:web:login*)",
      "Bash(sfdx force:auth:jwt:grant*)",
      "Bash(sfdx force:config:set*)",
      "Bash(sfdx force:alias:set*)",
      "Bash(sfdx force:package:*)"
    ]
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "timeout": 60,
            "statusMessage": "Initializing ACM-AI session..."
          },
          {
            "type": "command",
            "command": "echo 'ACM-AI session ready. Agent teams: ON. Run /sprint-status to see current state.'"
          }
        ]
      }
    ],
    "PreToolUse": [],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/story-done-check.sh\"",
            "timeout": 60
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/task-quality-gate.sh\"",
            "timeout": 180,
            "statusMessage": "Running quality gates..."
          }
        ]
      }
    ]
  }
}
