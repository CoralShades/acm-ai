-- Migration 19: Add structured fields to field_schema table (E1-S11 code review fix)
-- Improves query performance for active fields and enables database-level validation

-- Add structured fields for efficient querying
DEFINE FIELD active_field_names ON TABLE field_schema TYPE array<string>;
DEFINE FIELD field_count ON TABLE field_schema TYPE int;
DEFINE FIELD source_template ON TABLE field_schema TYPE option<string>;

-- Index for fast active field lookups
DEFINE INDEX idx_field_schema_active ON TABLE field_schema FIELDS active_field_names;
