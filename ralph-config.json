{
  "version": "1.0",
  "models": {
    "sm": "sonnet",
    "dev": "sonnet",
    "qa": "sonnet",
    "reviewer": "sonnet",
    "architect": "sonnet",
    "docs": "haiku"
  },
  "limits": {
    "maxIterations": 40,
    "devRetries": 2,
    "qaRetries": 1,
    "reviewRetries": 2,
    "agentMaxTurns": {
      "sm": 20,
      "dev": 50,
      "qa": 30,
      "reviewer": 15,
      "architect": 12,
      "docs": 10
    }
  },
  "phases": {
    "architect": true,
    "sm": true,
    "dev": true,
    "qa": true,
    "review": true,
    "commit": true,
    "docUpdate": true
  },
  "execution": {
    "dryRun": false,
    "autoCommit": true,
    "branchStrategy": "direct",
    "verbose": false,
    "pauseBeforeCommit": false,
    "pauseBetweenPhases": false
  },
  "selection": {
    "sortBy": "sprint-then-sp",
    "preferSmallWins": true,
    "maxStoryPoints": 0
  }
}
