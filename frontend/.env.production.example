# Vercel Production Environment Variables
# Set these in Vercel Dashboard → Project Settings → Environment Variables

# Server-side: Where Next.js rewrites proxy /api/* requests
# Points to the local Docker API via Cloudflare tunnel (stable URL, no pod ID needed)
INTERNAL_API_URL=https://api.coralshades.ai

# Server-side: Returned by /config route — browser uses this for API calls
# Set to the Vercel domain so all requests stay same-origin through the proxy
API_URL=https://demo.vaea.coralshades.ai

# Build-time: Fallback if /config route fails
NEXT_PUBLIC_API_URL=https://demo.vaea.coralshades.ai

# Build-time: Enable ACM navigation mode
NEXT_PUBLIC_ACM_MODE=true
